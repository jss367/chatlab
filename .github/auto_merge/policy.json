{
  "repository": "jss367/chatlab",
  "default_branch": "main",
  "trusted_authors": ["jss367"],
  "opt_in_label": "automerge",
  "opt_out_labels": ["no-automerge", "do-not-merge"],
  "ci_workflow": "ci.yml",
  "required_jobs": ["test", "Browser (chromium, ubuntu-24.04)", "Browser (webkit, macos-15)"],
  "required_steps": {
    "test": ["Install dependencies", "Lint", "Check reply types", "Test"],
    "Browser (chromium, ubuntu-24.04)": ["Install dependencies", "Install browser", "Test rendered interface"],
    "Browser (webkit, macos-15)": ["Install dependencies", "Install browser", "Test rendered interface"]
  },
  "blocked_path_prefixes": [".github/", "scripts/", "ChatLab.spec", "requirements-desktop.txt", "chatlab/version.py", "assets/", "deploy/", "release/"],
  "mode": "report"
}
